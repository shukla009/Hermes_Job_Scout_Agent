# Free-only core does not require any paid/model/search provider.
NVIDIA_API_KEY=
SERPAPI_KEY=
# Set the matching repository variable only after verifying account billing
# stops paid overages. Cloud runs fail closed until this is true.
ZERO_COST_VERIFIED=false
GITHUB_TOKEN=
SCOUT_SHADOW_RUNS=3
# Enable only after the updated Telegram worker is deployed and verified.
TELEGRAM_TRACKING_READY=false
