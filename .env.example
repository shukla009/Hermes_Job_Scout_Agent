ENABLE_JOB_ALERT_EMAILS=false
GMAIL_SENDER_EMAIL=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_authorized_telegram_chat_id
CANDIDATE_NAME=Shivank Shukla
CANDIDATE_PORTFOLIO=https://shivank-shukla-portfolio.vercel.app/
CANDIDATE_LINKEDIN=https://www.linkedin.com/in/shivank-shukla09
MAX_POST_AGE_DAYS=4
MAX_POST_AGE_HOURS=48
MAX_DIRECT_APPLY_AGE_DAYS=21
CANDIDATE_EMAIL=work.shuklashivank@gmail.com
CANDIDATE_PHONE=+91 9013584218
CANDIDATE_GITHUB=https://github.com/shukla009
MAX_APPLY_ALERTS=5
MAX_EMAILS_PER_RUN=3
MAX_EMAILS_PER_DAY=6
MAX_FOLLOWUPS_PER_RUN=2
